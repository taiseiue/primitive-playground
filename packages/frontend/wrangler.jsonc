  {
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "primitive-playground",
    "compatibility_date": "2026-03-01",
    "observability": {
      "enabled": true
    },
    "assets": {
      "directory": "dist",
      "not_found_handling": "single-page-application"
    },
    "compatibility_flags": [
      "nodejs_compat"
    ]
  }
